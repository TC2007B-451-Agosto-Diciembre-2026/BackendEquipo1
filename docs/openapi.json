    "/users/{id}/role": {
      "patch": {
        "operationId": "UsersController_updateRole",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ID único del usuario al que se le actualizará el rol",
            "schema": {
              "example": 1,
              "type": "number"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "ADMIN",
                      "USER"
                    ],
                    "example": "ADMIN",
                    "description": "Nuevo rol que se asignará al usuario"
                  }
                },
                "required": [
                  "role"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rol del usuario actualizado exitosamente"
          },
          "400": {
            "description": "Solicitud incorrecta — Datos del rol inválidos"
          },
          "401": {
            "description": "No autorizado — Token de acceso faltante o inválido"
          },
          "403": {
            "description": "Prohibido — Se requieren permisos de Administrador"
          },
          "404": {
            "description": "Usuario no encontrado"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Actualizar el rol de un usuario por su ID",
        "tags": [
          "users"
        ]
      }
    },
