  "info": {
    "title": "API Sistema de Reportes y Roles",
    "description": "API REST para la gestión de usuarios, roles y reportes.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://172.16.64.2/api",
      "description": "Laboratorio de redes (nginx)"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local (npm run start:dev)"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateRoleDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nombre de rol",
            "example": "Administrador"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateRoleDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nombre de rol",
            "example": "Administrador"
          }
        }
      },
      "CreateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Circulación y seguridad",
            "description": "Nombre de la categoría"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Circulación y seguridad",
            "description": "Nombre de la categoría"
          }
        }
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "juan@example.com"
          },
          "password": {
            "type": "string",
            "example": "secreto123",
            "minLength": 6
          },
          "name": {
            "type": "string",
            "example": "Juan Pérez"
          },
          "phone": {
            "type": "string",
            "example": "5512345678",
            "description": "Teléfono (opcional)"
          }
        },
        "required": [
          "email",
          "password",
          "name"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "atl@example.com",
            "description": "Correo electrónico registrado en la plataforma"
          },
          "password": {
            "type": "string",
            "example": "secreto1234",
            "description": "Contraseña de la cuenta"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Tu Nombre"
          },
          "email": {
            "type": "string",
            "example": "nuevo_email@example.com"
          },
          "phone": {
            "type": "string",
            "example": "5512345678"
          },
          "password": {
            "type": "string",
            "example": "nuevaClave123",
            "minLength": 6
          }
        }
      },
      "CreateReporteDto": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "number",
            "example": 1,
            "description": "ID de la categoría del reporte"
          },
          "caseType": {
            "type": "string",
            "example": "report",
            "enum": [
              "señalamiento",
              "report"
            ],
            "description": "Tipo de caso"
          },
          "title": {
            "type": "string",
            "example": "Sitio clonado de banco",
            "description": "Título del reporte (máx. 150 caracteres)"
          },
          "evidenceUrl": {
            "type": "string",
            "example": "https://banco-falso-login.com"
          },
          "description": {
            "type": "string",
            "example": "Se identificó un dominio malicioso que suplanta la identidad bancaria.",
            "description": "Descripción detallada"
          }
        },
        "required": [
          "categoryId",
          "caseType",
          "title",
          "evidenceUrl",
          "description"
        ]
      },
      "UpdateReporteDto": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "number",
            "example": 1,
            "description": "ID de la categoría del reporte"
          },
          "caseType": {
            "type": "string",
            "example": "report",
            "enum": [
              "señalamiento",
              "report"
            ],
            "description": "Tipo de caso"
          },
          "title": {
            "type": "string",
            "example": "Sitio clonado de banco",
            "description": "Título del reporte (máx. 150 caracteres)"
          },
          "description": {
            "type": "string",
            "example": "Se identificó un dominio malicioso que suplanta la identidad bancaria.",
            "description": "Descripción detallada"
          }
        }
      },
      "ChangeStatusDto": {
        "type": "object",
        "properties": {
          "statusId": {
            "type": "number",
            "example": 2,
            "description": "ID del estado de validación"
          },
          "fraudProbability": {
            "type": "number",
            "example": 85.5,
            "description": "Probabilidad de fraude (0.00 a 100.00)"
          }
        },
        "required": [
          "statusId"
        ]
      },
      "SummaryStatsDto": {
        "type": "object",
        "properties": {
          "totalReports": {
            "type": "number",
            "example": 120,
            "description": "Total histórico de reportes creados"
          },
          "pendingReports": {
            "type": "number",
            "example": 15,
            "description": "Reportes pendientes de revisión"
          },
          "approvedReports": {
            "type": "number",
            "example": 85,
            "description": "Reportes aprobados / validados"
          },
          "rejectedReports": {
            "type": "number",
            "example": 20,
            "description": "Reportes rechazados o desestimados"
          }
        },
        "required": [
          "totalReports",
          "pendingReports",
          "approvedReports",
          "rejectedReports"
        ]
      },
      "CategoryStatsDto": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "number",
            "example": 1,
            "description": "ID de la categoría"
          },
          "categoryName": {
            "type": "string",
            "example": "Circulación y seguridad",
            "description": "Nombre de la categoría"
          },
          "total": {
            "type": "number",
            "example": 45,
            "description": "Total de reportes en esta categoría"
          }
        },
        "required": [
          "categoryId",
          "categoryName",
          "total"
        ]
      },
      "StatusStatsDto": {
        "type": "object",
        "properties": {
          "statusId": {
            "type": "number",
            "example": 1,
            "description": "ID del estado"
          },
          "statusName": {
            "type": "string",
            "example": "En revisión",
            "description": "Nombre del estado"
          },
          "total": {
            "type": "number",
            "example": 15,
            "description": "Total de reportes con este estado"
          }
        },
        "required": [
          "statusId",
          "statusName",
          "total"
        ]
      },
      "MonthlyStatsDto": {
        "type": "object",
        "properties": {
          "month": {
            "type": "string",
            "example": "2026-09",
            "description": "Año y mes (YYYY-MM)"
          },
          "total": {
            "type": "number",
            "example": 32,
            "description": "Total de reportes creados en dicho mes"
          }
        },
        "required": [
          "month",
          "total"
        ]
      },
      "CreateValidationStatusDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "En investigación",
            "description": "Nombre del estado de validación"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateValidationStatusDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "En investigación",
            "description": "Nombre del estado de validación"
          }
        }
      }
    }
  }
}
